    "version": "0.2.0",
    "configurations": [
        {
            "type": "lldb",
            "request": "launch",
            "name": "microdocker",
            "cargo": {
                "args": [
                    "build",
                    "--bin=microdocker",
                    "--package=microdocker"
                ],
                "filter": {
                    "name": "microdocker",
                    "kind": "bin"
                }
            },
            "args": [],
            "cwd": "${workspaceFolder}"
        },
        {
            "type": "lldb",
            "request": "launch",
            "name": "microdocker (alpine)",
            "cargo": {
                "args": [
                    "build",
                    "--bin=microdocker",
                    "--package=microdocker"
                ],
                "filter": {
                    "name": "microdocker",
                    "kind": "bin"
                }
            },
            "args": ["run", "-v", "library/alpine"],
            "cwd": "${workspaceFolder}"
        }
    ]
}